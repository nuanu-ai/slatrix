    {
      "name": "Saving a removed message brings it back",
      "list": { "removed": [{ "room_id": "!design:example.org", "event_id": "$one", "ts": 1761955200000 }] },
      "room_id": "!design:example.org",
      "event_id": "$one",
      "now": 1761955300000,
