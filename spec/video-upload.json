{
  "about": "What sending a video puts in its event, as Slack's videos carry: m.video, with the video's size as it is shown, its length, its type and bytes, and a poster: a JPEG of a frame near the start, a second in or halfway through a shorter clip, at most 800 pixels on its longer side and never enlarged. video is the file as read, its pixels before the rotation its track asks for; posterBytes is the encoded poster's size, which the encoder decides, or null when no frame could be read. posterFrame is when the poster is taken from and the size it is drawn at; sent is the event's msgtype, body and info.",
  "cases": [
    {
      "name": "A landscape video sends its size, length, type and a poster",
      "video": { "name": "clip.mp4", "mimetype": "video/mp4", "size": 8192000, "width": 1920, "height": 1080, "rotation": 0, "durationMillis": 12500 },
      "posterBytes": 40960,
      "posterFrame": { "atMillis": 1000, "width": 800, "height": 450 },
      "sent": { "msgtype": "m.video", "body": "clip.mp4", "info": { "w": 1920, "h": 1080, "duration": 12500, "mimetype": "video/mp4", "size": 8192000,
        "thumbnail_info": { "w": 800, "h": 450, "mimetype": "image/jpeg", "size": 40960 } } }
    },
