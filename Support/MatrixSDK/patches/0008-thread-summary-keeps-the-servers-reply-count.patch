+#[async_test]
+async fn test_thread_read_receipt_keeps_the_bundled_reply_count() {
+    // A thread read receipt from another device makes a `ThreadInfo` before
+    // the event cache holds any of the thread's replies. The root still has
+    // as many replies as the server says.
+
+    let server = MatrixMockServer::new().await;
+    let client = client_with_threading_support(&server).await;
+    client.event_cache().subscribe().unwrap();
+
+    let room_id = room_id!("!a:b.c");
+    let thread_root = owned_event_id!("$root");
+    let own_user_id = client.user_id().unwrap().to_owned();
+    let f = EventFactory::new().room(room_id).sender(&ALICE);
+
+    let room = server
+        .sync_room(
+            &client,
+            JoinedRoomBuilder::new(room_id)
+                .add_timeline_event(
+                    f.text_msg("a change to review")
+                        .with_bundled_thread_summary(
+                            f.text_msg("looks good").event_id(event_id!("$latest")).into(),
+                            3,
+                            false,
+                        )
+                        .event_id(&thread_root),
+                )
+                .add_receipt(
+                    f.read_receipts()
+                        .add(
+                            event_id!("$latest"),
+                            &own_user_id,
+                            ReceiptType::Read,
+                            ReceiptThread::Thread(thread_root.clone()),
+                        )
+                        .into_event(),
+                ),
+        )
+        .await;
+
+    let timeline = room.timeline().await.unwrap();
+    let (mut items, mut stream) = timeline.subscribe().await;
+    while items.iter().all(|item| item.as_event().is_none()) {
+        assert_let_timeout!(Some(updates) = stream.next());
+        for update in updates {
+            update.apply(&mut items);
+        }
+    }
+
+    let root = items.iter().find_map(|item| item.as_event()).unwrap();
+    assert_let!(Some(summary) = root.content().thread_summary());
+    assert_eq!(summary.num_replies, 3);
+}
