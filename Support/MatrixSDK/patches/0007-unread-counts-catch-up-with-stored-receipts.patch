+    #[matrix_sdk_test::async_test]
+    async fn test_compute_unread_counts_catches_up_with_a_newer_stored_receipt() {
+        use matrix_sdk_base::{
+            StateChanges, StateStore as _, read_receipts::LatestReadReceipt,
+        };
+
+        let room_id = room_id!("!roomid:example.org");
+        let own_user_id = user_id!("@not_alice:example.org");
+        let f = EventFactory::new().room(room_id).sender(*ALICE);
+
+        let mut linked_chunk = EventLinkedChunk::new();
+        linked_chunk.push_events(vec![
+            f.text_msg("Event 1").event_id(event_id!("$1")).into_event(),
+            f.text_msg("Event 2").event_id(event_id!("$2")).into_event(),
+        ]);
+
+        // Another device read up to $2 while this one counted from $1, and the
+        // receipt reached the store without moving the count. An older
+        // unthreaded receipt sits on an event this chunk doesn't hold.
+        let state_store = MemoryStore::new();
+        let mut changes = StateChanges::default();
+        changes.add_receipts(
+            room_id,
+            f.read_receipts()
+                .add(
+                    event_id!("$elsewhere"),
+                    own_user_id,
+                    ReceiptType::Read,
+                    ReceiptThread::Unthreaded,
+                )
+                .add(event_id!("$2"), own_user_id, ReceiptType::Read, ReceiptThread::Main)
+                .into_content(),
+        );
+        state_store.save_changes(&changes).await.unwrap();
+
+        let event_filter = RoomReadReceiptEventFilter {
+            room_id,
+            with_threading_support: true,
+            state_store: &state_store,
+        };
+        let mut receipts = ReadReceipts::default();
+        receipts.latest_active = Some(LatestReadReceipt { event_id: owned_event_id!("$1") });
+        receipts.num_unread = 1;
+
+        super::compute_unread_counts(
+            own_user_id,
+            None,
+            &linked_chunk,
+            &event_filter,
+            &mut receipts,
+            None,
+        )
+        .await;
+
+        assert_eq!(receipts.num_unread, 0);
+    }
