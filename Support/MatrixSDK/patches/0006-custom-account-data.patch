+    /// Subscribe to updates of a global account data event of any type,
+    /// including custom ones, as raw JSON content.
+    ///
+    /// Every update a sync brings is delivered, in order, even when one sync
+    /// carries several account data events.
+    pub fn observe_raw_account_data_event(
+        &self,
+        event_type: String,
+        listener: Box<dyn RawAccountDataListener>,
+    ) -> Arc<TaskHandle> {
+        let (sender, mut receiver) = tokio::sync::mpsc::unbounded_channel::<String>();
+        let handler = self.inner.add_event_handler(move |event: Raw<AnyGlobalAccountDataEvent>| {
+            let sender = sender.clone();
+            let event_type = event_type.clone();
+            async move {
+                if event.get_field::<String>("type").ok().flatten().as_deref()
+                    != Some(event_type.as_str())
+                {
+                    return;
+                }
+                if let Ok(Some(content)) = event.get_field::<Box<RawJsonValue>>("content") {
+                    let _ = sender.send(content.get().to_owned());
+                }
+            }
+        });
+        // Dropping the guard, when the task ends or is cancelled, removes the handler.
+        let guard = self.inner.event_handler_drop_guard(handler);
+        Arc::new(TaskHandle::new(get_runtime_handle().spawn(async move {
+            let _guard = guard;
+            while let Some(content) = receiver.recv().await {
+                listener.on_change(content);
+            }
+        })))
+    }
