+/// A listener for changes of one global account data event type, including
+/// custom ones.
+#[matrix_sdk_ffi_macros::export(callback_interface)]
+pub trait RawAccountDataListener: SyncOutsideWasm + SendOutsideWasm {
+    /// Called with the event's content, as a JSON string, each time a sync
+    /// brings a new one.
+    fn on_change(&self, content: String);
+}
