+        let unopened = room_id!("!unopened:localhost");
+        fixture.client.base_client().get_or_create_room(unopened, RoomState::Joined);
+        {
+            let locked = fixture.client.event_cache_store().lock().await.unwrap();
+            let store = locked.as_clean().unwrap();
+            store
+                .handle_linked_chunk_updates(
+                    LinkedChunkId::Thread(fixture.room.room_id(), root),
+                    vec![
+                        Update::NewItemsChunk {
+                            previous: None,
+                            new: ChunkIdentifier::new(0),
+                            next: None,
+                        },
+                        Update::PushItems {
+                            at: Position::new(ChunkIdentifier::new(0), 0),
+                            items: vec![
+                                f.text_msg("threadonlyneedle").in_thread(root, root).into_event(),
+                            ],
+                        },
+                    ],
+                )
+                .await
+                .unwrap();
+        }
+        let mut replay = CachedSearchReplay::new();
+        replay.room(fixture.client.event_cache(), &fixture.client, unopened).await;
+        assert!(!replay.visited.contains(unopened));
+        assert!(!fixture.client.event_cache().inner.by_room.read().await.contains_key(unopened));
+        replay.room(fixture.client.event_cache(), &fixture.client, fixture.room.room_id()).await;
+        assert_eq!(fixture.room.search("rootneedle", 10, None).await.unwrap().events.len(), 1);
+        assert!(fixture.room.search("threadonlyneedle", 10, None).await.unwrap().events.is_empty());
+    }
