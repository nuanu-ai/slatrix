+    async fn test_room_left_while_queued_is_not_indexed() {
+        let fixture = fixture(vec![factory().text_msg("leftneedle").into_raw_sync()]).await;
+        let guard = fixture.client.search_index().lock().await;
+        let client = fixture.client.clone();
+        let id = fixture.room.room_id().to_owned();
+        let task = tokio::spawn(async move {
+            CachedSearchReplay::new().room(client.event_cache(), &client, &id).await;
+        });
+        for _ in 0..10 {
+            tokio::task::yield_now().await;
+        }
+        fixture
+            .server
+            .mock_sync()
+            .ok_and_run(&fixture.client, |builder| {
+                builder
+                    .add_left_room(matrix_sdk_test::LeftRoomBuilder::new(fixture.room.room_id()));
+            })
+            .await;
+        assert_eq!(fixture.room.state(), RoomState::Left);
+        drop(guard);
+        task.await.unwrap();
+        assert!(fixture.room.search("leftneedle", 10, None).await.unwrap().events.is_empty());
+    }
