+// Copyright 2026 The Matrix.org Foundation C.I.C.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Bounded, additive replay of already-cached room history into search.
+//! This never initializes a cache, paginates, saves events or broadcasts diffs.
+//! Thread-only/out-of-band history is not enumerated, nor is this an index GC.
+
+use std::{collections::HashSet, time::Duration};
+
+use futures_util::future::join_all;
+use matrix_sdk_base::{
+    cross_process_lock::MappedCrossProcessLockState,
+    linked_chunk::{ChunkContent, LinkedChunkId},
+    timeout::timeout,
+};
+use ruma::{OwnedEventId, OwnedRoomId, RoomId, time::Instant};
+use tracing::{info, warn};
+
+use super::{MAX_BACKFILL_WEEKS, WEEK, age_of};
+use crate::{
+    Client, Room, RoomState,
+    event_cache::{EventCache, Result, RoomEventCache},
+    search_index::parse_timeline_event,
+};
+
+const MAX_CHUNKS_PER_ROOM: usize = 32;
+const MAX_EVENTS_PER_ROOM: usize = 4_096;
+const MAX_EVENTS_TOTAL: usize = 32_768;
+const MAX_REPLAY_TIME: Duration = Duration::from_secs(30);
+
+pub(super) struct CachedSearchReplay {
+    visited: HashSet<OwnedRoomId>,
+    examined: usize,
+    spent: Duration,
+}
+
+impl CachedSearchReplay {
+    pub(super) fn new() -> Self {
+        Self { visited: HashSet::new(), examined: 0, spent: Duration::ZERO }
+    }
+
+    pub(super) async fn room(&mut self, cache: &EventCache, client: &Client, room_id: &RoomId) {
+        if self.visited.contains(room_id) || self.examined >= MAX_EVENTS_TOTAL {
+            return;
+        }
+        let remaining = MAX_REPLAY_TIME.saturating_sub(self.spent);
+        if remaining.is_zero() {
+            return;
+        }
+        let started = Instant::now();
+        // Cancellation drops this future and its guards; no detached work is
+        // spawned. A synchronous index commit can finish its current batch.
+        match timeout(self.room_inner(cache, client, room_id), remaining).await {
+            Ok(Ok(())) => {}
+            Ok(Err(_)) => warn!("Cached search replay could not read a cache batch"),
+            Err(_) => warn!("Cached search replay reached its time budget"),
+        }
+        self.spent += started.elapsed();
+    }
+
+    async fn room_inner(
+        &mut self,
+        cache: &EventCache,
+        client: &Client,
+        room_id: &RoomId,
+    ) -> Result<()> {
+        let Some(room) = client.get_room(room_id).filter(|room| room.state() == RoomState::Joined)
+        else {
+            return Ok(());
+        };
+        // Calling EventCache::room here would initialize unopened caches,
+        // enumerate all chunk metadata, and potentially repair bad storage.
+        let initialized = {
+            let rooms = cache.inner.by_room.read().await;
+            rooms.get(room_id).map(|caches| caches.room.clone())
+        };
+        let Some(room_cache) = initialized else { return Ok(()) };
+        self.visited.insert(room_id.to_owned());
+
+        let mut before = None;
+        let mut seen_chunks = HashSet::new();
+        let mut seen_events = HashSet::new();
+        let mut room_events = 0;
+        for _ in 0..MAX_CHUNKS_PER_ROOM {
+            if room.state() != RoomState::Joined
+                || room_events >= MAX_EVENTS_PER_ROOM
+                || self.examined >= MAX_EVENTS_TOTAL
+            {
+                break;
+            }
+            let capacity =
+                (MAX_EVENTS_PER_ROOM - room_events).min(MAX_EVENTS_TOTAL - self.examined).min(128);
+            // Copy only a bounded set of identities. Never wait for the search
+            // lock while retaining the cross-process event-store lock.
+            let snapshot = {
+                let locked = client.event_cache_store().lock().await?;
+                let MappedCrossProcessLockState::Clean(store) = locked else {
+                    // Leave dirty-store recovery to the normal cache lifecycle.
+                    return Ok(());
+                };
+                let id = LinkedChunkId::Room(room_id);
+                let raw = match before {
+                    None => store.load_last_chunk(id).await?.0,
+                    Some(previous) => store.load_previous_chunk(id, previous).await?,
+                };
+                raw.map(|raw| {
+                    let mut examined = 0;
+                    let ids = match raw.content {
+                        ChunkContent::Gap(_) => Vec::new(),
+                        ChunkContent::Items(events) => events
+                            .into_iter()
+                            .rev()
+                            .take(capacity)
+                            .filter_map(|event| {
+                                examined += 1;
+                                // Server timestamps are not monotonic. Exclude
+                                // known-old events individually; do not stop at
+                                // an old, missing or future timestamp.
+                                if event
+                                    .timestamp()
+                                    .and_then(age_of)
+                                    .is_some_and(|age| age > MAX_BACKFILL_WEEKS * WEEK)
+                                {
+                                    return None;
+                                }
+                                event.event_id().map(ToOwned::to_owned)
+                            })
+                            .collect::<Vec<_>>(),
+                    };
+                    (raw.identifier, raw.previous, examined, ids)
+                })
+            };
+            let Some((identifier, previous, examined, ids)) = snapshot else { break };
+            if !seen_chunks.insert(identifier) {
+                warn!("Cached search replay stopped at a repeated chunk");
+                break;
+            }
+            room_events += examined;
+            self.examined += examined;
+            let ids =
+                ids.into_iter().filter(|id| seen_events.insert(id.clone())).collect::<Vec<_>>();
+            if !replay_batch(client, &room, &room_cache, ids).await? {
+                break;
+            }
+            if previous.is_none() {
+                break;
+            }
+            before = Some(identifier);
+            tokio::task::yield_now().await;
+        }
+        Ok(())
+    }
+
+    pub(super) fn report(&self) {
+        info!(rooms_considered = self.visited.len(), events_considered = self.examined,
+            elapsed = ?self.spent, "Bounded cached search replay finished; coverage may be partial");
+    }
+}
+
+/// Keep the existing index→cache lock order. A live edit/redaction that won
+/// the index lock first is observed by these current-form reads; one arriving
+/// later is indexed after this batch. No old raw snapshot is ever re-added.
+async fn replay_batch(
+    client: &Client,
+    room: &Room,
+    cache: &RoomEventCache,
+    ids: Vec<OwnedEventId>,
+) -> Result<bool> {
+    if ids.is_empty() || room.state() != RoomState::Joined {
+        return Ok(true);
+    }
+    let mut index = client.search_index().lock().await;
+    if room.state() != RoomState::Joined {
+        return Ok(true);
+    }
+    let mut current = Vec::with_capacity(ids.len());
+    for id in ids {
+        if let Some(event) = cache.find_event(&id).await? {
+            current.push(event);
+        }
+    }
+    let rules = room.clone_info().room_version_rules_or_default().redaction;
+    let operations =
+        join_all(current.into_iter().map(|event| parse_timeline_event(cache, event, &rules)))
+            .await
+            .into_iter()
+            .flatten()
+            .collect::<Vec<_>>();
+    // Parsing awaits current relations. A room left during those awaits must
+    // not get a newly committed replay batch.
+    if !operations.is_empty() && room.state() == RoomState::Joined {
+        if index.bulk_execute(operations, room.room_id()).is_err() {
+            warn!("Cached search replay could not commit an index batch");
+            return Ok(false);
+        }
+    }
+    Ok(true)
+}
