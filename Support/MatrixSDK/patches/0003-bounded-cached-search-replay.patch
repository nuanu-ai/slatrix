+    #[async_test]
+    async fn test_dirty_snapshot_is_skipped_without_cache_recovery() {
+        let server = MatrixMockServer::new().await;
+        let store = Arc::new(MemoryStore::new());
+        let primary = server
+            .client_builder()
+            .on_builder(|builder| {
+                builder.store_config(
+                    StoreConfig::new(CrossProcessLockConfig::multi_process("replay-primary"))
+                        .event_cache_store(store.clone()),
+                )
+            })
+            .build()
+            .await;
+        primary.event_cache().subscribe().unwrap();
+        let room = server.sync_joined_room(&primary, room_id!("!replay:localhost")).await;
+        let (cache, _) = room.event_cache().await.unwrap();
+        let (_initial, mut updates) = cache.subscribe().await.unwrap();
+        let foreign = server
+            .client_builder()
+            .on_builder(|builder| {
+                builder.store_config(
+                    StoreConfig::new(CrossProcessLockConfig::multi_process("replay-foreign"))
+                        .event_cache_store(store),
+                )
+            })
+            .build()
+            .await;
+        drop(foreign.event_cache_store().lock().await.unwrap());
+        let mut replay = CachedSearchReplay::new();
+        replay.room(primary.event_cache(), &primary, room.room_id()).await;
+        assert_eq!(replay.examined, 0);
+        assert!(
+            primary.event_cache_store().lock().await.unwrap().as_clean().is_none(),
+            "replay must not mark dirty state recovered"
+        );
+        assert!(matches!(
+            updates.try_recv(),
+            Err(tokio::sync::broadcast::error::TryRecvError::Empty)
+        ));
+    }
