+    #[async_test]
+    async fn test_chunk_cap_bounds_recent_and_future_history() {
+        // Legal sparse chunks exercise the actual 32-chunk boundary without
+        // indexing thousands of unrelated messages as fixture setup.
+        let server = MatrixMockServer::new().await;
+        let store = Arc::new(MemoryStore::new());
+        let client = server
+            .client_builder()
+            .on_builder(|builder| {
+                builder.store_config(
+                    StoreConfig::new(CrossProcessLockConfig::SingleProcess)
+                        .event_cache_store(store),
+                )
+            })
+            .build()
+            .await;
+        let room_id = room_id!("!replay:localhost");
+        let f = factory();
+        let mut writes = Vec::new();
+        for i in 0..33 {
+            let id = ChunkIdentifier::new(i);
+            writes.push(Update::NewItemsChunk {
+                previous: if i == 0 { None } else { Some(ChunkIdentifier::new(i - 1)) },
+                new: id,
+                next: None,
+            });
+            writes.push(Update::PushItems {
+                at: Position::new(id, 0),
+                items: vec![
+                    f.text_msg(if i == 0 { "beyondcapneedle" } else { "boundedneedle" })
+                        .into_event(),
+                ],
+            });
+        }
+        {
+            let locked = client.event_cache_store().lock().await.unwrap();
+            locked
+                .as_clean()
+                .unwrap()
+                .handle_linked_chunk_updates(LinkedChunkId::Room(room_id), writes)
+                .await
+                .unwrap();
+        }
+        client.event_cache().subscribe().unwrap();
+        let room = server.sync_joined_room(&client, room_id).await;
+        let (_cache, _handles) = room.event_cache().await.unwrap();
+        let mut replay = CachedSearchReplay::new();
+        replay.room(client.event_cache(), &client, room.room_id()).await;
+        assert_eq!(replay.examined, 32);
+        assert!(room.search("beyondcapneedle", 10, None).await.unwrap().events.is_empty());
+        assert!(!room.search("boundedneedle", 10, None).await.unwrap().events.is_empty());
+    }
