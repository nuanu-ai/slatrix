+    let f = EventFactory::new().room(room_id).sender(*ALICE);
+    let original = f.text_msg("original").event_id(target);
+    let original = if threaded { original.in_thread(root, root) } else { original };
+    let original = if bundled {
+        original.with_bundled_edit(
+            f.text_msg("* old")
+                .event_id(old_edit)
+                .edit(target, RoomMessageEventContent::text_plain("old edit").into()),
+        )
+    } else {
+        original
+    };
+    server
+        .mock_room_event_context()
+        .room(room_id)
+        .ok(RoomContextResponseTemplate::new(original.into_event())
+            .events_after(if bundled {
+                vec![]
+            } else {
+                vec![
+                    f.text_msg("* old")
+                        .event_id(old_edit)
+                        .edit(target, RoomMessageEventContent::text_plain("old edit").into())
+                        .into_event(),
+                ]
+            })
+            .start("before-focus")
+            .end("after-focus"))
+        .mock_once()
+        .mount()
+        .await;
+    server.mock_room_state_encryption().plain().mount().await;
+    let room = server.sync_joined_room(&client, room_id).await;
+    let focus = TimelineFocus::Event {
+        target: target.to_owned(),
+        num_context_events: 20,
+        thread_mode: TimelineEventFocusThreadMode::Automatic { hide_threaded_events: false },
+    };
+    let timeline = TimelineBuilder::new(&room)
+        .track_read_marker_and_receipts(
+            matrix_sdk_ui::timeline::TimelineReadReceiptTracking::Disabled,
+        )
+        .with_focus(focus.clone())
+        .build()
+        .await
+        .unwrap();
+    // An automatic thread window filters the unthreaded edit in /context;
+    // seed its prior edit through a real sync as well.
+    server
+        .sync_room(
+            &client,
+            JoinedRoomBuilder::new(room_id).add_timeline_event(
+                f.text_msg("* old")
+                    .event_id(old_edit)
+                    .edit(target, RoomMessageEventContent::text_plain("old edit").into()),
+            ),
+        )
+        .await;
+    wait_for_focused_body(&timeline, "old edit").await;
+    server
+        .sync_room(
+            &client,
+            JoinedRoomBuilder::new(room_id).add_timeline_bulk([
+                f.text_msg("* new")
+                    .event_id(new_edit)
+                    .edit(target, RoomMessageEventContent::text_plain("current edit").into())
+                    .into(),
+                f.text_msg("unrelated live message").into(),
+                f.text_msg("unrelated thread message").in_thread(root, target).into(),
+            ]),
+        )
+        .await;
+    wait_for_focused_body(&timeline, "current edit").await;
+    let reused = TimelineBuilder::new(&room)
