+/// Keep only live aggregations of loaded focused events, including redactions
+/// of their edits/reactions. Ordinary room or thread messages do not extend the window.
+pub fn aggregate_timeline_for_focused_events(
+    timeline: &Timeline,
+    mut known_event_ids: HashSet<OwnedEventId>,
+    redaction_rules: &RedactionRules,
+) -> Timeline {
+    let mut related = HashMap::<OwnedEventId, Vec<OwnedEventId>>::new();
+    for event in &timeline.events {
+        let target = match extract_relation(event.raw()) {
+            Some((RelationType::Annotation | RelationType::Replacement, target)) => Some(target),
+            Some(_) => None,
+            None => extract_redaction_target(event.raw(), redaction_rules),
+        };
+        if let (Some(target), Some(id)) = (target, event.event_id()) {
+            related.entry(target).or_default().push(id.to_owned());
+        }
+    }
+    // Traverse each incoming relation once, even if a redaction precedes its
+    // edit in this sync batch. Final event order remains the server's order.
+    let mut pending: VecDeque<_> = known_event_ids.iter().cloned().collect();
+    while let Some(target) = pending.pop_front() {
+        if let Some(ids) = related.remove(&target) {
+            for id in ids {
+                if known_event_ids.insert(id.clone()) {
+                    pending.push_back(id);
+                }
+            }
+        }
+    }
+    let ids = known_event_ids.into_iter().collect::<Vec<_>>();
+    let mut result = aggregate_timeline_for_pinned_events(timeline, &ids, redaction_rules);
+    result.events.retain(|event| match extract_relation(event.raw()) {
+        Some((RelationType::Annotation | RelationType::Replacement, _)) => true,
+        Some(_) => false,
+        None => extract_redaction_target(event.raw(), redaction_rules).is_some(),
+    });
+    result
+}
