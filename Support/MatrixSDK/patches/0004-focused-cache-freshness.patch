+#[cfg(test)]
+mod focused_cache_regressions {
+    use super::*;
+    use crate::timeline::controller::ObservableItems;
+    use ruma::{event_id, user_id};
+
+    #[test]
+    fn removing_aggregation_is_idempotent_and_keeps_siblings() {
+        let target = TimelineEventItemId::EventId(event_id!("$target").to_owned());
+        let removed = TimelineEventItemId::EventId(event_id!("$removed").to_owned());
+        let sibling = TimelineEventItemId::EventId(event_id!("$sibling").to_owned());
+        let mut aggregations = Aggregations::default();
+        for id in [&removed, &sibling] {
+            aggregations.add(
+                target.clone(),
+                Aggregation {
+                    kind: AggregationKind::Reaction {
+                        key: "👍".into(),
+                        sender: user_id!("@alice:example.org").to_owned(),
+                        timestamp: MilliSecondsSinceUnixEpoch::now(),
+                    },
+                    own_id: id.clone(),
+                    send_state: None,
+                    send_handle: None,
+                },
+            );
+        }
+        let mut items = ObservableItems::new();
+        let mut transaction = items.transaction();
+        assert!(aggregations.try_remove_aggregation(&removed, &mut transaction).unwrap());
+        assert!(!aggregations.inverted_map.contains_key(&removed));
+        assert!(!aggregations.try_remove_aggregation(&removed, &mut transaction).unwrap());
+        assert_eq!(aggregations.related_events[&target].len(), 1);
+        assert_eq!(aggregations.related_events[&target][0].own_id, sibling);
+        assert_eq!(aggregations.inverted_map[&sibling], target);
+    }
+}
