+async fn check_focused_cache_reuses_current_edits(threaded: bool, bundled: bool) {
+    let room_id = room_id!("!focused-freshness:example.org");
+    let target = event_id!("$focused-original");
+    let root = event_id!("$thread-root");
+    let old_edit = event_id!("$old-edit");
+    let new_edit = event_id!("$new-edit");
