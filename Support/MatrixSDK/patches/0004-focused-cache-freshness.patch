+#[async_test]
+async fn test_failed_local_redaction_preserves_remote_edit_rollback() {
+    let timeline = TestTimeline::new().await;
+    let f = &timeline.factory;
+    let original = event_id!("$original-with-edit");
+    let edit = event_id!("$remote-edit");
+    timeline.handle_live_event(f.text_msg("original").sender(*ALICE).event_id(original)).await;
+    timeline
+        .handle_live_event(f.text_msg("* edited").sender(*ALICE).event_id(edit).edit(
+            original,
+            ruma::events::room::message::RoomMessageEventContent::text_plain("edited").into(),
+        ))
+        .await;
+    let redaction = timeline.handle_local_redaction(original.to_owned()).await;
+    timeline
+        .controller
+        .update_event_send_state(
+            &redaction,
+            EventSendState::SendingFailed {
+                error: Arc::new(matrix_sdk::Error::SendQueueWedgeError(Box::new(
+                    QueueWedgeError::GenericApiError { msg: "fixture failure".into() },
+                ))),
+                is_recoverable: false,
+            },
+        )
+        .await;
+    assert!(timeline.controller.discard_local_echo(&redaction).await);
+    let items = timeline.controller.items().await;
+    let item = items.iter().filter_map(|item| item.as_event()).next().unwrap();
+    assert_eq!(item.content().as_message().unwrap().body(), "edited");
+    assert!(item.unedited_kind.is_some());
+    timeline.handle_live_event(f.redaction(edit).sender(*ALICE)).await;
+    let items = timeline.controller.items().await;
+    let item = items.iter().filter_map(|item| item.as_event()).next().unwrap();
+    assert_eq!(item.content().as_message().unwrap().body(), "original");
+    assert!(item.latest_edit_json().is_none());
+    timeline.handle_live_event(f.redaction(original).sender(*ALICE)).await;
+    let items = timeline.controller.items().await;
+    let item = items.iter().filter_map(|item| item.as_event()).next().unwrap();
+    assert!(item.content().is_redacted());
+    assert!(item.unedited_kind.is_none());
+    assert!(item.unredacted_item.is_none());
+}
