+async fn wait_for_focused_body(timeline: &matrix_sdk_ui::Timeline, expected: &str) {
+    tokio::time::timeout(Duration::from_secs(3), async {
+        loop {
+            if timeline
+                .items()
+                .await
+                .iter()
+                .filter_map(|item| item.as_event())
+                .filter_map(|item| item.content().as_message())
+                .any(|message| message.body() == expected)
+            {
+                break;
+            }
+            sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .unwrap_or_else(|_| panic!("focused body must become {expected:?}"));
+}
