+
+    /// Aborts every change to an existing event (a redaction, an edit or a
+    /// reaction) that the server refused, in every room with unsent requests,
+    /// and returns what it aborted.
+    ///
+    /// Such a request stays at the head of its room's send queue and holds up
+    /// everything sent after it, across restarts. New events are left alone,
+    /// as is a request wedged by a rejected access token, which the send queue
+    /// retries by itself once the token is refreshed. A request that couldn't
+    /// be aborted is left for the next call.
+    pub async fn abort_refused_changes(&self) -> Result<Vec<RefusedChange>, ClientError> {
+        use matrix_sdk::{QueueWedgeError, send_queue::LocalEchoContent};
+
+        let refused = |error: &Option<QueueWedgeError>| {
+            error
+                .as_ref()
+                .is_some_and(|error| !matches!(error, QueueWedgeError::ExpiredAccessToken))
+        };
+
+        let mut aborted = Vec::new();
+        for (room_id, echoes) in self.inner.send_queue().local_echoes().await? {
+            for echo in echoes {
+                let ((event_id, kind), handle) = match echo.content {
+                    LocalEchoContent::Redaction { redacts, send_handle, send_error, .. }
+                        if refused(&send_error) =>
+                    {
+                        ((redacts.to_string(), RefusedChangeKind::Redaction), send_handle)
+                    }
+                    LocalEchoContent::Event { serialized_event, send_handle, send_error }
+                        if refused(&send_error) =>
+                    {
+                        let Some(change) = changed_event(&serialized_event) else { continue };
+                        (change, send_handle)
+                    }
+                    _ => continue,
+                };
+                match handle.abort().await {
+                    Ok(true) => {
+                        aborted.push(RefusedChange { room_id: room_id.to_string(), event_id, kind })
+                    }
+                    Ok(false) => {}
+                    Err(err) => warn!("couldn't abort a refused change: {err}"),
+                }
+            }
+        }
+        Ok(aborted)
     }
 
