+/// What [`Client::abort_refused_changes`] cancelled about an existing event.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, uniffi::Enum)]
+pub enum RefusedChangeKind {
+    /// Its redaction.
+    Redaction,
+    /// An edit of it.
+    Edit,
+    /// A reaction to it.
+    Reaction,
+}
+
+/// A change to an existing event that the server refused, and that
+/// [`Client::abort_refused_changes`] took out of its room's send queue.
+#[derive(Clone, Debug, uniffi::Record)]
+pub struct RefusedChange {
+    /// The room whose send queue held the change.
+    pub room_id: String,
+    /// The event the change applied to.
+    pub event_id: String,
+    /// What the change was.
+    pub kind: RefusedChangeKind,
+}
+
+/// The event an edit or a reaction applies to, or `None` for any other event.
+fn changed_event(
+    content: &matrix_sdk::store::SerializableEventContent,
+) -> Option<(String, RefusedChangeKind)> {
+    #[derive(Deserialize)]
+    struct RelatesTo {
+        rel_type: String,
+        event_id: String,
+    }
+
+    let relation = content.raw().0.get_field::<RelatesTo>("m.relates_to").ok().flatten()?;
+    let kind = match relation.rel_type.as_str() {
+        "m.replace" => RefusedChangeKind::Edit,
+        "m.annotation" => RefusedChangeKind::Reaction,
+        _ => return None,
+    };
+    Some((relation.event_id, kind))
+}
